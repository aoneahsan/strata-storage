{
  "name": "strata-storage",
  "version": "3.1.3",
  "description": "One storage API across web, iOS and Android — zero runtime dependencies.",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "ios/",
    "android/",
    "bin/",
    "StrataStorage.podspec",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AI-INTEGRATION-GUIDE.md",
    "!**/CLAUDE.md",
    "!**/AGENTS.md"
  ],
  "bin": "./bin/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capacitor": {
      "types": "./dist/capacitor.d.ts",
      "default": "./dist/capacitor.js"
    },
    "./firebase": {
      "types": "./dist/firebase.d.ts",
      "default": "./dist/firebase.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "default": "./dist/integrations/react/index.js"
    },
    "./vue": {
      "types": "./dist/integrations/vue/index.d.ts",
      "default": "./dist/integrations/vue/index.js"
    },
    "./angular": {
      "types": "./dist/integrations/angular/index.d.ts",
      "default": "./dist/integrations/angular/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node -e \"const fs=require('fs');fs.copyFileSync('LICENSE','dist/LICENSE');fs.writeFileSync('dist/package.json',JSON.stringify({type:'module',sideEffects:false},null,2)+'\\n')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "typecheck:clean": "tsc --noEmit --incremental false",
    "lint": "eslint 'src/**/*.{ts,tsx}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "gates": "yarn typecheck && yarn lint && yarn build && yarn test",
    "deps:outdated": "npx -y npm-check-updates",
    "deps:update": "npx -y npm-check-updates -u --reject typescript && yarn install",
    "prepack": "yarn gates"
  },
  "keywords": [
    "storage",
    "capacitor",
    "localstorage",
    "indexeddb",
    "sqlite",
    "keychain",
    "cross-platform",
    "zero-dependencies",
    "react",
    "vue",
    "angular",
    "typescript"
  ],
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "contributors": [
    "Strata Storage Team"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/strata-storage.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/strata-storage/issues",
    "email": "aoneahsan@gmail.com"
  },
  "homepage": "https://stratastorage-docs.aoneahsan.com",
  "funding": "https://aoneahsan.com/payment?project-id=strata-storage&project-identifier=strata-storage",
  "peerDependencies": {
    "@angular/core": ">=21.0.6",
    "@angular/forms": ">=21.0.6",
    "@capacitor/core": ">=8.0.0",
    "firebase": ">=10.0.0",
    "react": ">=19.2.3",
    "vue": ">=3.5.26"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@capacitor/core": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "zone.js": "~0.16.3"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android",
      "androidModule": "strata-storage"
    }
  }
}
